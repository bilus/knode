{
  "packages": [
    "ghc@9.10.3",
    "cabal-install@latest",
    "stack@latest",
    "hpack@latest",
    "haskell-language-server@latest",
    "hlint@latest",
    "path:./flakes/ormolu#default",
    "haskellPackages.hoogle",
    "gmp@latest",
    "zlib@latest",
    "python@3.12",
    "pipx",
    "graphviz",
    "stylish-haskell@latest",
    "fourmolu@latest"
  ],
  "env": {
    "PATH": "$PATH:/usr/bin"
  },
  "shell": {
    "init_hook": [
      "echo \"knode dev shell — ghc $(ghc --numeric-version), hls $(haskell-language-server-wrapper --numeric-version 2>/dev/null || echo '?')\"",
      "pipx install data-flow-diagram",
      "pipx inject data-flow-diagram typing_extensions"
    ]
  }
}
